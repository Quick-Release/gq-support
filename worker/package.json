{
  "name": "gq-support-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "deploy-gate": "node --import ./node_modules/alchemy/bin/register-oxc.js scripts/deploy-gate.ts",
    "destroy": "node scripts/destroy.ts",
    "operator": "node --import ./node_modules/alchemy/bin/register-oxc.js scripts/operator.ts",
    "recovery-drill": "node scripts/recovery-drill.ts",
    "readiness": "node --import ./node_modules/alchemy/bin/register-oxc.js scripts/readiness.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "load-test": "vitest run --config vitest.load.config.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.86",
    "@effect/platform-node": "4.1.4",
    "alchemy": "2.0.0-beta.86",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "miniflare": "5.20260916.0-alpha",
    "typescript": "^5.7.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "^4.133.0"
  }
}
