{
  "name": "gq-support-for-wp",
  "private": true,
  "version": "0.0.1",
  "description": "WordPress plugin: in-dashboard chat for editors/admins to report bugs",
  "scripts": {
    "dev:app": "pnpm --filter gq-support-app dev",
    "build:app": "pnpm --filter gq-support-app build",
    "dev:worker": "pnpm --filter gq-support-worker dev",
    "deploy:worker": "pnpm --filter gq-support-worker deploy"
  }
}
